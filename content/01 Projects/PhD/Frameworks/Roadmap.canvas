		{"id":"80ddc4a33b2b6167","type":"text","text":"What should GP(-trainees) be able to do?","x":1617,"y":248,"width":250,"height":102},
		{"id":"c66120c1bdd19fe2","type":"text","text":"<center>What is currently taught?</center>","x":1620,"y":-34,"width":250,"height":89},
